# ═══════════════════════════════════════════════════════════════════════════════
# Apex University Examination Seating Management System - Backend Environment
# ═══════════════════════════════════════════════════════════════════════════════

# Server Port and Runtime Environment
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YourSecurePasswordHere
DB_NAME=exam_seating_system

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# Bcrypt Security
BCRYPT_ROUNDS=10

# Single Authorized Admin / Exam Planner Configuration
# The database will initialize and synchronize this single authorized planner account on startup
ADMIN_NAME=Exam Controller / Administrator
ADMIN_EMAIL=admin@exam.edu
ADMIN_PASSWORD=Admin@123

# CORS Configuration (comma-separated origins or * for open access)
CORS_ORIGIN=*

# Optional: Path to custom Chromium binary in production container/VPS environments
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
